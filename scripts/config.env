# Environment for the plant simulators (sourced by `make run_*`).
# See docs/plants.md for the full description of each variable.

# Controller endpoint (local service or Kubernetes NodePort, e.g. http://192.168.0.51:30005/control)
export CONTROLLER_URL="http://localhost:5000/control"

# Request period in ms. 0 = free-running (next request right after the reply,
# behaviour of the original experiments); 10 = one request per simulation step.
export REQUEST_PERIOD_MS=0

# Run duration in seconds (0 = until SIGINT/SIGTERM).
export DURATION_S=0

# 0 = new TCP connection per request (load balanced per request by kube-proxy),
# 1 = persistent connection (all requests of a plant go to the same pod).
export HTTP_KEEPALIVE=0

# Request timeout in ms (0 = no timeout).
export HTTP_TIMEOUT_MS=0

# Write one CSV row every N control iterations.
export LOG_EVERY=1

# Identifier sent to the controller. Defaults to the CSV file name without ".csv".
# export CLIENT_ID="car-client-1"
