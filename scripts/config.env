# Ambiente dos simuladores de planta (carregado por `make run_*`).
# A descrição completa de cada variável está em docs/plants.md.

# Endpoint do controlador (serviço local ou NodePort do Kubernetes, ex.: http://192.168.0.51:30005/control)
export CONTROLLER_URL="http://localhost:5000/control"

# Período entre requisições, em ms. 0 = modo livre (próxima requisição logo após a
# resposta, comportamento dos experimentos originais); 10 = uma requisição por passo de simulação.
export REQUEST_PERIOD_MS=0

# Duração da execução em segundos (0 = até SIGINT/SIGTERM).
export DURATION_S=0

# 0 = conexão TCP nova por requisição (balanceada por requisição pelo kube-proxy),
# 1 = conexão persistente (todas as requisições de uma planta vão para o mesmo pod).
export HTTP_KEEPALIVE=0

# Timeout da requisição em ms (0 = sem timeout).
export HTTP_TIMEOUT_MS=0

# Grava uma linha no CSV a cada N iterações de controle.
export LOG_EVERY=1

# Identificador enviado ao controlador. O padrão é o nome do CSV sem ".csv".
# export CLIENT_ID="car-client-1"
